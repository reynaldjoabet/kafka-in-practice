# Read by docker-compose.yml. Change these, not the compose file.

KAFKA_IMAGE=apache/kafka:4.4.0

# One id for the life of the cluster. New cluster: bin/kafka-storage.sh random-uuid
CLUSTER_ID=JyM8fjpPROuic6KuRywfKw

# Sized so six nodes fit on a laptop. Production brokers: 6g heap in a 32-64g machine,
# because the rest of the memory becomes the page cache that serves reads.
CONTROLLER_HEAP=-Xms1g -Xmx1g
CONTROLLER_MEMORY=2g
BROKER_HEAP=-Xms2g -Xmx2g
BROKER_MEMORY=4g
BROKER_CPUS=2
NUM_NETWORK_THREADS=3
NUM_IO_THREADS=8
